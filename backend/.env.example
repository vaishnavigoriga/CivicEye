PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Connection String (leave empty to automatically use in-memory MongoDB for turnkey demo!)
MONGO_URI=mongodb://localhost:27017/civiceye

# JWT Authentication Secret
JWT_SECRET=civiceye_super_secret_jwt_key_2026_dev_mode

# Google Gemini API Key (Optional - application runs full mock AI if omitted or empty)
GEMINI_API_KEY=

# File Storage: local | cloudinary
STORAGE_DRIVER=local
CLOUDINARY_URL=

# Severity scoring weights (must sum to 1.0)
SEVERITY_WEIGHT_AI=0.40
SEVERITY_WEIGHT_UPVOTES=0.25
SEVERITY_WEIGHT_SAFETY=0.20
SEVERITY_WEIGHT_DURATION=0.15

# Duplicate detection
DUPLICATE_JACCARD_THRESHOLD=0.35
DUPLICATE_RADIUS_METRES=500
DUPLICATE_LOOKBACK_DAYS=30

# ---- Server ----
PORT=4000
NODE_ENV=development
# Origin of the frontend (used for strict CORS). Must match exactly.
FRONTEND_URL=http://localhost:5173
# Set to true when running behind a reverse proxy / load balancer (so rate limiting sees real client IPs).
TRUST_PROXY=false

# ---- Database ----
# A real MongoDB connection string (local, or MongoDB Atlas).
MONGO_URI=mongodb://127.0.0.1:27017/civiceye
# Development/testing only: use a throw-away in-memory MongoDB instead. All data is lost on restart.
# Ignored MONGO_URI when true. Refused in production.
USE_MEMORY_DB=false

# ---- Authentication ----
# REQUIRED. Generate a long random value, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production it must be at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# First administrator (optional). If both are set, the account is created at startup when it does not exist.
# Use a strong password (12+ characters). Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=CivicEye Administrator

# ---- Demo data ----
# true = add clearly labelled DEMO complaints at startup (never counted as real complaint statistics).
SEED_DEMO_DATA=false

# ---- AI (Gemini) ----
# Server-side only. Never put this in the frontend or in VITE_ variables.
GEMINI_API_KEY=
# Models verified against the live API on 2026-11-21 (override if Google retires or renames them).
# gemini-2.5-flash is no longer available to new users; larger Flash models were far slower for this workload.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TIMEOUT_MS=30000
# If a configured Gemini call fails: false = save the report with ai.status "failed" and no AI result (default);
# true = fall back to the keyword-based simulated analysis, clearly labelled as simulated.
AI_DEMO_FALLBACK=false
# Check every Gemini feature live (key is never printed):  npm run ai:smoke

# ---- Prototype scoring model (weights should sum to 1.0; this is NOT an official standard) ----
SCORING_WEIGHT_SAFETY=0.35
SCORING_WEIGHT_AFFECTED=0.25
SCORING_WEIGHT_EVIDENCE=0.20
SCORING_WEIGHT_DURATION=0.20
SCORING_DURATION_SATURATION_DAYS=30

# ---- Duplicate detection ----
DUPLICATE_RADIUS_METRES=200
DUPLICATE_LOOKBACK_DAYS=30
DUPLICATE_SCORE_THRESHOLD=0.3

# ---- Rate limits (requests per window) ----
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_SUBMIT_MAX=20
RATE_LIMIT_AI_MAX=30

# ---- Uploads ----
MAX_UPLOAD_BYTES=10485760
